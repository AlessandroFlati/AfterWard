# Pass these as environment variables. The portable app does not read .env files.
PORT=8776
AFTERWARD_HOSTED=0
AFTERWARD_DATA_DIR=.afterward-data
# Hosted only: use your exact domain, without a scheme or trailing slash.
# AFTERWARD_PUBLIC_HOST=afterward-demo.up.railway.app
# API is opt-in. Never commit a real key.
AFTERWARD_AMD_ENABLED=0
AMD_TOKEN_FACTORY_API_KEY=
AFTERWARD_AMD_FREE_QUOTA_CONFIRMED=0
AFTERWARD_API_TOTAL_LIMIT=200
AFTERWARD_API_DAILY_LIMIT=100
# Set a future UTC expiry date for the intended demonstration period.
AFTERWARD_API_EXPIRES=
